# PostgreSQL connection string
# Update this with your actual database credentials
DATABASE_URL="postgresql://user:password@localhost:5432/transitops?schema=public"

# Session Secret (32 character base64 string)
# Generate a new one using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="your-32-character-base64-secret-key-here"
